{
  "name": "qa-mobile-appium-webdriverio",
  "version": "1.0.0",
  "private": true,
  "description": "Base de automacao Android com Appium, WebdriverIO, TypeScript e Page Objects.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "wdio": "wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --suite smoke",
    "typecheck": "tsc --noEmit",
    "devices": "adb devices -l",
    "doctor": "appium driver doctor uiautomator2",
    "appium": "appium --address 127.0.0.1 --port 4723",
    "inspector:config": "node --import tsx scripts/inspector-config.ts"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "typescript",
    "android",
    "qa",
    "test-automation"
  ],
  "devDependencies": {
    "@wdio/appium-service": "9.27.1",
    "@wdio/cli": "9.27.1",
    "@wdio/globals": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/spec-reporter": "9.27.1",
    "@wdio/types": "9.27.1",
    "@types/node": "24.10.1",
    "appium": "3.4.2",
    "appium-uiautomator2-driver": "7.4.0",
    "expect-webdriverio": "5.6.5",
    "typescript": "7.0.2",
    "tsx": "4.21.1"
  }
}
